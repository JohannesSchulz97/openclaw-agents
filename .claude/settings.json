        "inputPatterns": [".*\\.gitignore.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/validate-gitignore.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "inputPatterns": [".*\\.gitignore.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/validate-gitignore.sh"
          }
        ]
      }
    ]
  }
}
