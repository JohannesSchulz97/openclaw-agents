{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "inputPatterns": [".*jobs-config\\.json.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/cron-conventions.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "inputPatterns": [".*jobs-config\\.json.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/cron-conventions.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "inputPatterns": [".*types/.*/scripts/.*\\.sh.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/script-conventions.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "inputPatterns": [".*types/.*/scripts/.*\\.sh.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/script-conventions.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "inputPatterns": [".*types/.*/(?:AGENTS|SOUL|TOOLS|BOOTSTRAP|HEARTBEAT)\\.md.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/workspace-layer.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "inputPatterns": [".*types/.*/(?:AGENTS|SOUL|TOOLS|BOOTSTRAP|HEARTBEAT)\\.md.*"],
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev/workspace-layer.sh"
          }
        ]
      }
    ]
  }
}
